# Copy this file to .env and fill in real values before running the app.

# Shared login password for the whole instance (required, no default).
APP_PASSWORD=change-me

# Random secret used to sign session cookies (required, no default).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# SQLAlchemy database URL.
# Inside Docker this points at the mounted volume; for local dev without
# Docker you may prefer a relative path, e.g. sqlite:///./data/spotifrei.db
DATABASE_URL=sqlite:////app/data/spotifrei.db

# Directory where downloaded audio files are stored.
# For local dev without Docker, e.g. ./data/storage
STORAGE_DIR=/app/data/storage

# Audio format yt-dlp extracts to.
AUDIO_FORMAT=mp3

# Host port docker-compose publishes the app on (container always listens on
# 8000 internally). Only read by docker-compose, not the app itself.
HOST_PORT=8000
