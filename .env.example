# Copy this file to .env and fill in real values before running the app.

# Optional. Only used once, by the one-time migration that runs if this
# instance already had profiles from before real accounts existed — it
# becomes the password of a legacy "owner@local" account created to hold
# them. Fresh installs don't need this at all; everyone registers their own
# account via /register instead.
#APP_PASSWORD=change-me

# Random secret used to sign session cookies (required, no default).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# SQLAlchemy database URL.
# Inside Docker this points at the mounted volume; for local dev without
# Docker you may prefer a relative path, e.g. sqlite:///./data/spotea.db
DATABASE_URL=sqlite:////app/data/spotea.db

# Directory where downloaded audio files are stored.
# For local dev without Docker, e.g. ./data/storage
STORAGE_DIR=/app/data/storage

# Audio format yt-dlp extracts to. m4a matches YouTube's native audio stream
# for almost every video, so extraction is a fast remux instead of a
# duration-scaled re-encode. Other formats (e.g. mp3) still work but are
# slower to prepare since they require transcoding.
AUDIO_FORMAT=m4a

# Which country's YouTube Music charts the Explore tab shows. The default
# "ZZ" is YouTube Music's global chart; set a two-letter country code to get
# that country's instead.
#MUSIC_CHART_COUNTRY=TR

# Host port docker-compose publishes the app on (container always listens on
# 8000 internally). Only read by docker-compose, not the app itself.
HOST_PORT=8000
